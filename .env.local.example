NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client bundle. Used for /admin and /api/admin/* + /api/track.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=

# Server-only. E-post til ADMIN_EMAIL ved nye fraseforslag og tilbakemeldinger (resend.com → API Keys).
RESEND_API_KEY=
# Valgfri avsender, f.eks. "Legeassistent <varsel@ditt-domene.no>". Uten denne brukes Resends testavsender,
# som bare kan sende til e-postadressen som eier Resend-kontoen.
EMAIL_FROM=
