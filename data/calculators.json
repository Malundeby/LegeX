      },
      {
        "max": 24,
        "label": "Godt kontrollert (20-24)",
        "color": "#ff9800"
      },
      {
        "max": 25,
        "label": "Fullstendig kontrollert (25)",
        "color": "#4caf50"
      }
    ]
