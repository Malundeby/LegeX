  {
    "id": "act",
    "name": "🫁 Astma kontroll voksne",
    "description": "Asthma Control Test for voksne (12 år+). Astmakontroll siste 4 uker.",
    "pdfUrl": "/pdfs/Utredningsskjema-ACT-voksne.pdf",
    "layout": "horizontal",
    "fields": [
      {
        "id": "q1",
        "label": "Hvor mye hindret astmaen deg i å få utført oppgaver på jobben, i skolen eller hjemme?",
        "type": "select",
        "options": [
          "1 – Hele tiden",
          "2 – Mesteparten av tiden",
          "3 – Noe av tiden",
          "4 – Litt av tiden",
          "5 – Ikke i det hele tatt"
        ]
      },
      {
        "id": "q2",
        "label": "Hvor ofte har du hatt kortpustethet?",
        "type": "select",
        "options": [
          "1 – Mer enn én gang om dagen",
          "2 – Én gang om dagen",
          "3 – 3 til 6 ganger i uken",
          "4 – En eller to ganger i uken",
          "5 – Ikke i det hele tatt"
        ]
      },
      {
        "id": "q3",
        "label": "Hvor ofte våknet du om natten eller tidligere enn vanlig på morgenen på grunn av astmasymptomer?",
        "type": "select",
        "options": [
          "1 – 4 eller flere netter i uken",
          "2 – 2 til 3 netter i uken",
          "3 – Én gang i uken",
          "4 – Én eller to ganger",
          "5 – Ikke i det hele tatt"
        ]
      },
      {
        "id": "q4",
        "label": "Hvor ofte brukte du inhalasjonsmedisin ved anfallsbehandling (salbutamol)?",
        "type": "select",
        "options": [
          "1 – 3 eller flere ganger om dagen",
          "2 – 1 eller 2 ganger om dagen",
          "3 – 2 eller 3 ganger i uken",
          "4 – Én gang i uken eller sjeldnere",
          "5 – Ikke i det hele tatt"
        ]
      },
      {
        "id": "q5",
        "label": "Hvordan vil du vurdere din astmakontroll de siste 4 ukene?",
        "type": "select",
        "options": [
          "1 – Ikke kontrollert i det hele tatt",
          "2 – Dårlig kontrollert",
          "3 – Noe kontrollert",
          "4 – Godt kontrollert",
          "5 – Fullstendig kontrollert"
        ]
      }
    ],
    "thresholds": [
